.tmp/
*.tsbuildinfo

# Node / frontend build
frontend/node_modules/
# frontend/dist/ is committed intentionally: run_windows.bat serves it
# directly, so a fresh `git clone` on a target PC needs no Node.js install.

# Runtime data (not source)
backend/uploads/
backend/testrunner_results/
backend/can_logs/

# Real vehicle/OEM DBC files (proprietary, not for the public repo) —
# samples/sample.dbc stays tracked, it's a small synthetic file used by tests.
samples/AMP_FD_260501.dbc
samples/AMP_HS_260201.dbc

# Derived from the proprietary AMP_FD/AMP_HS DBCs above (real OEM signal/
# message names, or the DBC's full VAL_ table re-exported to xlsx) -- same
# reason as the DBCs themselves, not for the public repo.
samples/CAN_Test_Script_Editor_Rev01.xlsx
samples/CAN_Test_Script_Editor_Rev01.json
samples/test_script_Rev01.json
samples/func_script_Rev01.json
samples/TestScript_Excel/
samples/TestScript_Excel09.zip
/Temp_req.json

# Saved layouts can embed a loaded DBC's full text (see POST
# /api/layouts/{name}) -- default2/3 were saved against the proprietary
# AMP_FD DBC above and must stay local-only. default.json/default1.json/
# Test01.json used to be tracked on purpose (no embedded DBC content at the
# time), but were untracked on request (2026-08-13) -- keep every
# backend/layouts/*.json local-only from here on rather than re-auditing
# each one's content before deciding.
backend/layouts/*.json

# Legacy Automation/ dump (proprietary OEM DBCs, Vector vxlapi DLLs, large
# .blf CAN logs, draft scripts) -- kept local only as reference material for
# the test-runner port (see Requirement.md "Automation 시나리오 러너 통합
# 계획"). Not for the public repo.
Automation/
Automation.zip

# Real OEM security-access DLL (HKMC_AdvancedSeedKey), its known-answer
# seed/key test vectors, and OEM ECU firmware binaries dropped into
# reference/ for local testing -- these were previously committed and
# leaked to the public GitHub remote, then purged from history via
# git-filter-repo. Never track these again.
reference/**/*.dll
reference/**/*.bin
reference/ask_client.py

